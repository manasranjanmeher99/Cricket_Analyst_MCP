# Required for the GPT agent
OPENAI_API_KEY=your_openai_api_key_here

# Optional. The default is a current GPT model.
OPENAI_MODEL=gpt-5.6

# Optional. Enables live player/match data via CricketData.org's free API
# (100 requests/day, no credit card). Get a key at:
#   https://cricketdata.org/signup.aspx
# If unset, the app falls back to built-in sample data (5 mock players).
CRICAPI_KEY=your_cricketdata_org_api_key_here
